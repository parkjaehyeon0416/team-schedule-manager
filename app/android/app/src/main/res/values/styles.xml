<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <!-- ★ v18.14 — 원래 DayNight 테마라 시스템 다크모드일 때 앱이 따라가려고 하면서
         네이티브 입력창 배경만 어둡게 바뀌어 글씨가 안 보이던 문제 발생.
         이 앱은 다크모드 UI를 전혀 지원하지 않으므로(전부 밝은 배경 하드코딩)
         시스템 설정과 무관하게 항상 라이트 테마로 고정. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- ★ v18.36 — 앱 시작 직후(JS 스플래시가 뜨기 전) 배경을 스플래시와 같은 흰색으로 맞춤.
             안드로이드 12+는 이 배경 위에 앱 아이콘을 띄우는 시스템 스플래시를 먼저 보여줌. -->
        <item name="android:windowBackground">@android:color/white</item>
        <!-- ★ v18.68 — 상태바 시계·아이콘이 흰색이라 밝은 화면에서 안 보이던 문제.
             targetSdk 36이라 안드로이드 15+는 앱이 상태바 뒤까지 그려지고(상태바 색 지정 무시, 투명),
             이 테마는 아이콘 색을 따로 정하지 않아 흰 아이콘 → 흰 헤더 위에서 사라졌음.
             · windowLightStatusBar: 어두운 아이콘(앱이 거의 전부 밝은 배경). JS가 뜨기 전 첫 화면부터 적용
             · statusBarColor: 안드로이드 14 이하(상태바가 따로 칠해짐)는 회색 바탕이라 어두운 아이콘이 안 보이니 흰색으로
             위쪽이 어두운 화면만 JS에서 밝은 아이콘으로 바꿈(components/FocusStatusBar.tsx, App.tsx 참고) -->
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
