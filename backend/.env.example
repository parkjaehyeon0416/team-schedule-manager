APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ★ v18.69 앱 업데이트 안내·강제(config/app_version.php). 버전은 MAJOR.MINOR.PATCH(versionName과 같은 번호)
#   MIN보다 낮은 앱 → API 426 강제 업데이트 / LATEST보다 낮은 앱 → 선택 업데이트 안내. 바꾼 뒤 php artisan config:cache
APP_MIN_VERSION_ANDROID=1.0.0
APP_LATEST_VERSION_ANDROID=1.0.0
APP_MIN_VERSION_IOS=1.0.0
APP_LATEST_VERSION_IOS=1.0.0
# 업데이트 창 문구(선택, 줄마다 짧게). ★ 반드시 큰따옴표로 감쌀 것 — 예: APP_UPDATE_MESSAGE="보안 업데이트가 있어요"
#   따옴표 없이 띄어쓰기를 넣으면 .env를 못 읽어(InvalidFileException) 설정 캐시 없는 서버는 사이트 전체가 멈춤
#   여러 줄은 "|"로 구분(\n 도 됨, 최대 5줄) — 앱은 체크 표시 줄로 그림(강제 업데이트 화면 2줄, 선택 안내 창 3줄까지)
#   예: APP_UPDATE_MESSAGE="회원가입 휴대폰 인증이 추가됐어요|견적서를 고객에게 바로 보낼 수 있어요|자잘한 오류를 고쳤어요"
APP_UPDATE_MESSAGE=""
# 스토어 주소: 비우면 초대 페이지용 PLAY_STORE_URL / APP_STORE_URL(config/workmate.php)을 그대로 씀 → 한 곳만 고치면 됨
#   (Android는 둘 다 비면 기본 플레이 주소, iPhone은 앱스토어 등록 전까지 비움)
APP_STORE_URL_ANDROID=
APP_STORE_URL_IOS=
APP_APK_URL=https://workmatekr.com/download/latest
